# Copy to .env and fill in. Never commit real values.

# Google Street View image/metadata collection (local only).
# Default OSM route planning needs no Google key.
GOOGLE_MAPS_API_KEY=

# Route planning: osm (free OSRM + Nominatim) or google (paid opt-in).
ROUTING_PROVIDER=osm
ROUTING_OSRM_URL=https://routing.openstreetmap.de/routed-car
ROUTING_NOMINATIM_URL=https://nominatim.openstreetmap.org
# Combined routing + uncached geocoding attempts per Pacific day (0 blocks).
ROUTING_DAILY_CAP=300
# Optional absolute writable counter path; public default is in /tmp.
# ROUTING_QUOTA_PATH=
# Legacy aliases still work when the corresponding ROUTING_* value is unset:
# GOOGLE_DIRECTIONS_DAILY_CAP=300
# GOOGLE_DIRECTIONS_QUOTA_PATH=
# Public service duties: identifying User-Agent, <=1 request/s per service,
# cached user-triggered searches only; no autocomplete, bulk or scraping.
# Limits apply across the whole application: multiple instances need a shared
# limiter/proxy or separately hosted services. See docs/SECURITY.md.
# Display OSM/ODbL credit, OSRM/FOSSGIS route credit and a "fix the map" link.
# https://routing.openstreetmap.de/about.html
# https://operations.osmfoundation.org/policies/nominatim/

# Postgres/PostGIS (docker compose up -d db)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/smooth_route

# --- Auth (Clerk) ---
# "clerk" verifies Bearer JWTs; "disabled" = local single-user mode (everything
# runs as admin — development only, never in production).
AUTH_MODE=clerk
# Secret key from https://dashboard.clerk.com → API Keys (sk_test_... in dev).
# Used for backend→Clerk API calls (e.g. email lookup at first login).
CLERK_SECRET_KEY=
# Issuer of the Clerk instance, e.g. https://your-app.clerk.accounts.dev
# (JWKS is derived as {CLERK_ISSUER}/.well-known/jwks.json)
CLERK_ISSUER=
# Origins accepted in the token azp claim (comma-separated).
CLERK_AUTHORIZED_PARTIES=http://localhost:5173
